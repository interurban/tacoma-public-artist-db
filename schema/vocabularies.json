{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/interurban/tacoma-public-artist-db/main/schema/vocabularies.json",
  "$comment": "Version 1. Propose vocabulary additions in a pull request; preserve existing identifiers.",
  "$defs": {
    "type": {
      "type": "string",
      "enum": ["artist", "studio", "gallery", "makerspace", "print-shop", "other"]
    },
    "medium": {
      "type": "string",
      "enum": ["book-arts", "ceramics", "digital-art", "drawing", "fashion", "fiber", "film", "glass", "illustration", "installation", "jewelry", "letterpress", "metal", "mixed-media", "music", "painting", "performance", "photography", "printmaking", "sculpture", "wood", "writing", "other"]
    },
    "neighborhood": {
      "type": "string",
      "description": "Broad Tacoma neighborhood council areas. Use null when not confirmed; never derive a location from an artwork's installation site.",
      "enum": ["central-tacoma", "eastside", "new-tacoma", "north-end", "northeast-tacoma", "south-end", "south-tacoma", "west-end"]
    },
    "focus_tag": {
      "type": "string",
      "enum": ["public-art", "workshops", "kids-workshops", "commissions-open", "exhibitions", "artist-books", "murals"]
    },
    "visit_policy": {
      "type": "string",
      "enum": ["walk-in", "by-appointment", "open-studios-only", "not-open-to-public"]
    },
    "award_kind": {
      "type": "string",
      "description": "The kind of recognition an entry records in awards; a certificate or scholarship is not a grant or residency.",
      "enum": ["award", "grant", "residency", "fellowship", "scholarship"]
    }
  }
}
